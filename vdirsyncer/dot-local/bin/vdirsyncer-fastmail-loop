#!/usr/bin/env bash
set -u

export PATH=/usr/bin:/bin
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/1000}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=/run/user/1000/bus}"
export PASSWORD_STORE_GPG_OPTS="--batch --no-tty"

interval="${VDIRSYNCER_FASTMAIL_INTERVAL:-10}"
backoff="${VDIRSYNCER_FASTMAIL_BACKOFF:-60}"
discover_interval="${VDIRSYNCER_FASTMAIL_DISCOVER_INTERVAL:-300}"
lockfile="${VDIRSYNCER_LOCKFILE:-/tmp/vdirsyncer.lock}"
probe="${VDIRSYNCER_GPG_PROBE:-${HOME}/.local/state/vdirsyncer/probe.asc}"

pairs=(
	fastmail_contacts
	fastmail_calendars
	fastmail_tasks
	fastmail_nextidea_contacts
)
discovery_pairs=(fastmail_tasks fastmail_nextidea_contacts fastmail_nextidea_caldav)
nextidea_collection_cache="${HOME}/.local/state/vdirsyncer/status/fastmail_nextidea_caldav.collections"
declare -A retry_after=()
last_discovery=0

log() {
	printf '%s %s\n' "$(date -Is)" "$*"
}

sleep_for() {
	local seconds="$1"
	sleep "$seconds" &
	wait $!
}

sync_with_backoff() {
	local key="$1"
	shift
	local now
	now=$(date +%s)
	if ((now < ${retry_after[$key]:-0})); then
		return
	fi
	if /usr/bin/flock -n "$lockfile" /usr/bin/vdirsyncer sync "$@"; then
		unset "retry_after[$key]"
	else
		local status=$?
		retry_after[$key]=$((now + backoff))
		log "sync failed key=${key} status=${status}; retrying after ${backoff}s"
	fi
}

nextidea_collection_ids() {
	/usr/bin/python3 - "$nextidea_collection_cache" <<'PY'
import json
import sys

try:
    with open(sys.argv[1], encoding="utf-8") as handle:
        state = json.load(handle)
    for collection_id, _ in state.get("collections", []):
        print(collection_id)
except (OSError, ValueError):
    pass
PY
}

trap 'log "stopping"; exit 0' INT TERM

log "starting interval=${interval}s discover_interval=${discover_interval}s pairs=${pairs[*]}"

while :; do
	if ! gpg --batch --no-tty --quiet --decrypt "$probe" >/dev/null 2>&1; then
		log "gpg agent locked; skipping tick"
		sleep_for "$interval"
		continue
	fi

	now=$(date +%s)
	if ((now - last_discovery >= discover_interval)); then
		# These pairs use collections=["from b"], so accepting discovery prompts
		# may create local collection directories but cannot create remote ones.
		if /usr/bin/yes y | /usr/bin/flock -n "$lockfile" \
			/usr/bin/vdirsyncer discover "${discovery_pairs[@]}"; then
			log "collection discovery complete pairs=${discovery_pairs[*]}"
		else
			log "collection discovery failed; retaining the previous collection cache"
		fi
		last_discovery=$now
	fi

	sync_with_backoff "fastmail-base" "${pairs[@]}"
	while IFS= read -r collection_id; do
		[[ -n "$collection_id" ]] || continue
		sync_with_backoff \
			"fastmail-nextidea-caldav/${collection_id}" \
			"fastmail_nextidea_caldav/${collection_id}"
	done < <(nextidea_collection_ids)
	sleep_for "$interval"
done
