[general]
status_path = "~/.local/state/vdirsyncer/status/"

# Daylite contacts: CardDAV -> local .vcf vdir
[pair daylite_contacts]
a = "daylite_contacts_local"
b = "daylite_contacts_remote"
collections = ["from a", "from b"]
metadata = ["displayname"]
# Fail loudly on conflicts until the Daylite DAV projection is understood.
# conflict_resolution = null

[storage daylite_contacts_local]
type = "filesystem"
path = "~/.local/share/vdir/daylite/contacts/"
fileext = ".vcf"

[storage daylite_contacts_remote]
type = "carddav"
url.fetch = ["command", "pass", "show", "api/daylite/caldav/server-url"]
username.fetch = ["command", "pass", "show", "api/daylite/caldav/username"]
password.fetch = ["command", "pass", "show", "api/daylite/caldav/app-password"]

# Daylite tasks/todos: CalDAV VTODO -> local .ics vdir
[pair daylite_tasks]
a = "daylite_tasks_local"
b = "daylite_tasks_remote"
# Daylite publishes task collections alongside normal calendars.
collections = ["task_inbox", "task_worklist"]
metadata = ["displayname", "color", "description"]
# conflict_resolution = null

[storage daylite_tasks_local]
type = "filesystem"
path = "~/.local/share/vdir/daylite/tasks/"
fileext = ".ics"

[storage daylite_tasks_remote]
type = "caldav"
url.fetch = ["command", "pass", "show", "api/daylite/caldav/server-url"]
username.fetch = ["command", "pass", "show", "api/daylite/caldav/username"]
password.fetch = ["command", "pass", "show", "api/daylite/caldav/app-password"]
item_types = ["VTODO"]

