# nextidea Fastmail contacts: discover every server-side address book.
# "from b" keeps collection discovery provider-authoritative: discovery may
# create local directories, but never creates remote address books.
[pair fastmail_nextidea_contacts]
a = "fastmail_nextidea_contacts_local"
b = "fastmail_nextidea_contacts_remote"
collections = ["from b"]
metadata = ["displayname"]
# conflict_resolution = null

[storage fastmail_nextidea_contacts_local]
type = "filesystem"
path = "~/.local/share/vdir/fastmail-nextidea/contacts/"
fileext = ".vcf"

[storage fastmail_nextidea_contacts_remote]
type = "carddav"
url = "https://carddav.fastmail.com/"
username = "craig@nextidea.io"
password.fetch = ["command", "pass", "show", "api/fastmail/craig@nextidea.io/dav/app-password"]

# nextidea Fastmail CalDAV: discover every server-side collection and sync
# both calendar events and todos into one collection-preserving local tree.
[pair fastmail_nextidea_caldav]
a = "fastmail_nextidea_caldav_local"
b = "fastmail_nextidea_caldav_remote"
collections = ["from b"]
metadata = ["displayname", "color", "description"]
# conflict_resolution = null

[storage fastmail_nextidea_caldav_local]
type = "filesystem"
path = "~/.local/share/vdir/fastmail-nextidea/caldav/"
fileext = ".ics"

[storage fastmail_nextidea_caldav_remote]
type = "caldav"
url = "https://caldav.fastmail.com/"
username = "craig@nextidea.io"
password.fetch = ["command", "pass", "show", "api/fastmail/craig@nextidea.io/dav/app-password"]
item_types = ["VEVENT", "VTODO"]
