#!/bin/sh
# Account tags by physical path, plus a reconciled inbox marker.
# Idempotent: notmuch tag applies set-union; path:/folder: select the
# account's own subtree. Runs after every successful `notmuch new`
# (mbsync, jmapsyncd index_refresh_hook, or manual).
#
# inbox is RECONCILED to physical INBOX membership (per account), not
# stamped at index time: Gmail archive removes the INBOX label, so a stale
# tag would lie. tag:inbox is a search convenience for standalone notmuch;
# Email never consumes it (Email uses folder:/path: membership).
notmuch tag +account:google -- path:google/**
notmuch tag +account:fastmail -- path:fastmail/**
notmuch tag +account:nextidea -- path:fastmail-nextidea/**
notmuch tag +account:icloud -- path:icloud/**

notmuch tag +inbox -- "(folder:google/INBOX or folder:fastmail/Inbox or folder:fastmail-nextidea/Inbox or folder:icloud/INBOX) and not tag:inbox"
notmuch tag -inbox -- "not folder:google/INBOX and not folder:fastmail/Inbox and not folder:fastmail-nextidea/Inbox and not folder:icloud/INBOX and tag:inbox"
