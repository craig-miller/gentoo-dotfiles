description="Google Workspace sync loop (mbsync + notmuch refresh)"

supervisor=supervise-daemon
command="/home/craig/.local/bin/mbsync-nextidea-daemon"
command_args=""

# The wrapper writes its own state/log; direct output elsewhere is noise.
output_log="/dev/null"
error_log="${MBSYNC_NEXTIDEA_ERROR_LOG:-/dev/null}"

depend() {
	after net jmapsyncd
}

start_pre() {
	checkpath -q -d -o "${command_user:-$USER}" "$HOME/.local/state/mbsync-nextidea"
}
